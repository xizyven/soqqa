# ---------------------------------------------------------------------------
# SOQQA environment variables. Copy to .env.local and fill in what you use.
# Everything is optional: without any variables the app runs fully offline
# (local-only mode, offline NLP parser, offline advisor).
# ---------------------------------------------------------------------------

# Supabase (cloud sync + email auth). Public values, safe for the browser:
# all data access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic Claude (optional cloud AI parser + advisor). SERVER-SIDE ONLY.
# Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
SOQQA_AI_MODEL=

# Allow AI endpoints without a signed-in Supabase user (local demos only).
# In production keep this unset/false so only authenticated users can call AI.
AI_ALLOW_ANONYMOUS=false

# No Supabase service-role key is needed. If you ever add one for admin tasks,
# keep it server-side only and never expose it to the client bundle.
